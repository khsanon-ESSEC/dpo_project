# Copier ce fichier en .env et l'adapter. Ne jamais versionner le fichier .env.

# Base PostgreSQL (version 14 ou plus récente).
# Avec docker compose : renseigner seulement POSTGRES_PASSWORD, DATABASE_URL est construit tout seul.
POSTGRES_PASSWORD=changer-ce-mot-de-passe
# Sans docker compose (base existante de la banque) :
DATABASE_URL=postgres://dpo:changer-ce-mot-de-passe@localhost:5432/dpo

# Adresse publique de l'application, telle que la tapent les utilisateurs
APP_URL=https://pilotage.dpo.unibank.local

# Durée d'une session, en heures (déconnexion automatique au-delà)
SESSION_HEURES=12

# Cookies réservés à HTTPS (préfixe __Host-). Laisser à 1 en production ; 0 seulement pour un essai local en http.
COOKIE_SECURISE=1

# Fuseau horaire de la division (semaines, échéances, rapports du vendredi)
APP_TZ=America/Port-au-Prince

# Mois où commence l'exercice de la banque (bilan par exercice) : 10 = octobre (1er octobre – 30 septembre).
EXERCICE_DEBUT_MOIS=10

# DÉMONSTRATION SEULEMENT : fige « aujourd'hui » à une date (AAAA-MM-JJ), par exemple un vendredi.
# Laisser vide en production.
DATE_DEMO=

# ---- Assistant (facultatif) ----
# aucun | openai-compatible | anthropic
# « aucun » : l'application fonctionne sans IA ; les brouillons sont préparés par des règles simples.
IA_FOURNISSEUR=aucun
# Pour openai-compatible : OpenAI, Azure OpenAI, ou un modèle hébergé par la banque (vLLM, Ollama…)
IA_URL=
IA_CLE=
IA_MODELE=
# Délai maximal d'une réponse de l'IA, en secondes
IA_DELAI=30

# ---- Connexion avec le compte Google de la banque (facultatif) ----
# Activée seulement si les trois valeurs sont renseignées ; sinon, connexion par mot de passe seulement.
# Client OAuth « Application Web » créé dans la console Google Cloud de la banque, avec l'adresse de retour
#   <APP_URL>/api/auth/google/retour
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domaine Google Workspace de la banque (unibankhaiti.com). Plusieurs domaines : séparés par des virgules.
GOOGLE_DOMAINE=unibankhaiti.com

# ---- Connexion avec le compte Windows de la banque : Active Directory (facultatif) ----
# Activée seulement si AD_URL, AD_DOMAINE et AD_BASE_DN sont renseignés. LDAPS seulement (ldaps://, port 636) ;
# plusieurs contrôleurs de domaine, séparés par des virgules, essayés dans l'ordre.
AD_URL=
# Domaine AD (suffixe des noms d'utilisateur, ex. : unibank.local) : on se lie avec identifiant@AD_DOMAINE.
AD_DOMAINE=
# Où chercher les comptes (ex. : DC=unibank,DC=local)
AD_BASE_DN=
# Autorité de certification de la banque (fichier PEM), si elle n'est pas dans le magasin du système.
AD_CA=
# Facultatif : groupe AD dont il faut être membre (DN complet ; groupes imbriqués acceptés).
AD_GROUPE=
# Facultatif : autre forme du nom de liaison, ex. « UNIBANK\{identifiant} ». Par défaut {identifiant}@{domaine}.
AD_LIAISON=
# Essais manqués par identifiant avant l'attente. Garder SOUS le seuil de verrouillage d'AD.
AD_ESSAIS_MAX=3
# Durée de l'attente et fenêtre de comptage, en minutes : au moins celle du verrouillage d'AD (15 par défaut).
AD_FENETRE_MINUTES=15

# ---- Rappels du vendredi par courriel (facultatif) ----
# Activés seulement si SMTP_HOTE, SMTP_EXPEDITEUR et APP_URL sont renseignés. Deux courriels au plus par
# personne et par semaine : « prêt à relire », puis le rappel si le rapport n'est pas parti (heures du modèle
# de rapport). Le courriel ne contient qu'un lien vers le rapport, rien de son contenu.
# Serveur de courriel de la banque (relais Exchange / Microsoft 365 / Google Workspace)
SMTP_HOTE=
# starttls (par défaut, port 587) : passage obligatoire en TLS ; implicite : TLS dès la connexion (port 465) ;
# aucun : relais interne sans TLS, seulement sans compte (un mot de passe ne passe jamais en clair).
SMTP_TLS=starttls
SMTP_PORT=
# Compte d'envoi, si le relais en demande un
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# Adresse d'expédition, ex. : Pilotage des projets <pilotage@unibankhaiti.com>
SMTP_EXPEDITEUR=
# Autorité de certification de la banque (fichier PEM), si elle n'est pas dans le magasin du système.
SMTP_CA=
# Intervalle de la tournée des rappels, en minutes (1 à 60)
RAPPELS_INTERVALLE_MINUTES=5
