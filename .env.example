# Copier ce fichier en .env et l'adapter. Ne jamais versionner le fichier .env.

# Base PostgreSQL (version 14 ou plus récente).
# Avec docker compose : renseigner seulement POSTGRES_PASSWORD, DATABASE_URL est construit tout seul.
POSTGRES_PASSWORD=changer-ce-mot-de-passe
# Sans docker compose (base existante de la banque) :
DATABASE_URL=postgres://dpo:changer-ce-mot-de-passe@localhost:5432/dpo

# Adresse publique de l'application, telle que la tapent les utilisateurs
APP_URL=https://pilotage.dpo.unibank.local

# Durée d'une session, en heures (déconnexion automatique au-delà)
SESSION_HEURES=12

# Cookies réservés à HTTPS. Laisser à 1 en production ; 0 seulement pour un essai local en http.
COOKIE_SECURISE=1

# Fuseau horaire de la division (semaines, échéances, rapports du vendredi)
APP_TZ=America/Port-au-Prince

# DÉMONSTRATION SEULEMENT : fige « aujourd'hui » à une date (AAAA-MM-JJ), par exemple un vendredi.
# Laisser vide en production.
DATE_DEMO=

# ---- Assistant (facultatif) ----
# aucun | openai-compatible | anthropic
# « aucun » : l'application fonctionne sans IA ; les brouillons sont préparés par des règles simples.
IA_FOURNISSEUR=aucun
# Pour openai-compatible : OpenAI, Azure OpenAI, ou un modèle hébergé par la banque (vLLM, Ollama…)
IA_URL=
IA_CLE=
IA_MODELE=
# Délai maximal d'une réponse de l'IA, en secondes
IA_DELAI=30

# ---- Connexion avec le compte Google de la banque (facultatif) ----
# Activée seulement si les trois valeurs sont renseignées ; sinon, connexion par mot de passe seulement.
# Client OAuth « Application Web » créé dans la console Google Cloud de la banque, avec l'adresse de retour
#   <APP_URL>/api/auth/google/retour
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domaine(s) Google Workspace de la banque, séparés par des virgules (à confirmer par l'informatique).
GOOGLE_DOMAINE=unibankhaiti.com
