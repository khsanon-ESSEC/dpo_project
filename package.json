{
  "name": "pilotage-projets-dpo",
  "version": "0.1.0",
  "private": true,
  "description": "Pilotage des projets de la Division des Projets Organisationnels (UNIBANK) : tâches, rapports du vendredi, portefeuille, rapport mensuel au conseil.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrer.mjs",
    "db:seed": "node scripts/semer.mjs",
    "user:create": "node scripts/creer-utilisateur.mjs",
    "test": "vitest run",
    "local": "node scripts/local.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "docx": "9.15.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "ldapts": "9.2.0",
    "next": "16.4.3",
    "nodemailer": "10.1.7",
    "postgres": "3.4.9",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.6",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "16.14.0-beta.17",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
